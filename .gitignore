# Dados — nunca versionados (volume e confidencialidade: PDVs, CNPJs, valores)
bases/
data/

# Template: os arquivos de exemplo levam dados reais do painel (CNPJs, valores). Ficam no disco (o pipeline se valida
# contra eles; Scorecard_DN_base.html e example-data*.json saem de `python run_dn.py --regerar-exemplo`), fora do git.
# Só o template.html (o molde da página) é versionado.
template/*
!template/template.html

